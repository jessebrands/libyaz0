#ifndef LIBYAZ0_CONFIG_H
#define LIBYAZ0_CONFIG_H

#define YAZ0_MAKE_VERSION(major, minor, patch)                                \
      ((((major) & 0x7FFF) << 16)                                             \
    |  (((minor) & 0xFF)   << 8)                                              \
    |   ((patch) & 0xFF))

#define YAZ0_VERSION_STRING "@PROJECT_VERSION@"
#define YAZ0_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define YAZ0_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define YAZ0_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define YAZ0_VERSION YAZ0_MAKE_VERSION(YAZ0_VERSION_MAJOR, YAZ0_VERSION_MINOR, YAZ0_VERSION_PATCH)

#endif //LIBYAZ0_CONFIG_H
